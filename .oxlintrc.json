{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["react", "typescript", "oxc"],
  // The audit scripts (tools/audit) are throwaway Node + Playwright drivers, not part of the app.
  "ignorePatterns": ["tools/**"],
  "rules": {
    "react/rules-of-hooks": "error",
    "react/only-export-components": ["warn", { "allowConstantExport": true }]
  },
  "overrides": [
    {
      // The administration keeps a provider and the hook that reads it in one file (session, text, toasts, confirmation):
      // they are one idea, and there is no fast-refresh workflow that depends on splitting them.
      "files": ["src/admin/**"],
      "rules": { "react/only-export-components": "off" }
    },
    {
      // The 3D scene mutates Three.js objects (cameras, materials, lights) inside per-frame
      // callbacks. That is how React Three Fiber is meant to be used, and re-rendering per frame
      // would defeat the point, so the "no mutation" rule does not apply there.
      "files": ["src/components/hero/**"],
      "rules": { "react/immutability": "off" }
    },
    {
      // The Lab's scenes are the same kind of code: they write into Three.js objects, uniforms and
      // plain simulation arrays inside per-frame callbacks, and into a mutable controls object that
      // the panel and the scene share instead of React state (so a slider never re-renders the scene).
      "files": ["src/components/lab/**"],
      "rules": { "react/immutability": "off" }
    }
  ]
}
