# Copy to `.env` (or set these in the host's environment) and fill in what applies. This file holds NO secrets: every
# value below is an example or a blank. `.env` itself is git-ignored; never commit one.
#
# Two kinds of setting live here:
#   * the BACKEND's (server/): read at run time by `npm run server:start`, checked at start-up; a wrong or missing
#     value stops the server with a message that names it (exit status 78). `npm run server:cli -- check` validates
#     them without starting anything and prints the result with every secret left out.
#   * the WEBSITE's (VITE_*): read at BUILD time and compiled into the public files. They are public by nature; a
#     secret must never be given a VITE_ name.
# Full descriptions: docs/backend/README.md ("Configuration").

# ---------------------------------------------------------------------------------------------------------------
# BACKEND — environment
# ---------------------------------------------------------------------------------------------------------------

# development | test | production. Production refuses everything that is unsafe in it (no APP_SECRET, a wildcard or
# http CORS origin, the `file` e-mail provider, SMTP in clear text, an in-memory database).
APP_ENV=development

# Where the server listens. Behind a reverse proxy keep HOST on the loopback address.
HOST=127.0.0.1
PORT=8787

# The public origins (scheme + host, no path): the website, and the backend if it is on another host. API_PUBLIC_URL
# starting with https:// turns on Secure cookies (and the __Host- cookie name) for the administration.
PUBLIC_URL=
API_PUBLIC_URL=

# The websites allowed to call the public API from a browser: exact origins, comma-separated, no wildcard.
# Leave empty when the backend serves the website itself (STATIC_DIR) and nothing else calls it from a browser.
CORS_ORIGINS=http://localhost:5173

# ---------------------------------------------------------------------------------------------------------------
# BACKEND — data
# ---------------------------------------------------------------------------------------------------------------

# The SQLite file. Production: an absolute path on a disk that survives restarts, and back it up (docs/backend/README.md).
DATABASE_PATH=./data/app.sqlite

# Where uploaded pictures (the portfolio's images) are kept, and the largest upload in bytes (100 kB - 25 MB, default 6 MB).
# Default: a "media" folder beside the database. Back it up together with the database (docs/cms/README.md).
# MEDIA_DIR=./data/media
# MEDIA_MAX_BYTES=6291456

# Apply pending schema migrations / load the website's catalogue into an EMPTY database when the server starts.
MIGRATE_ON_START=true
SEED_ON_START=true

# ---------------------------------------------------------------------------------------------------------------
# BACKEND — secrets and safety
# ---------------------------------------------------------------------------------------------------------------

# At least 32 random characters in production (for example: openssl rand -base64 48). It keys the hash of visitors'
# network addresses and the sign-in form's token. Changing it signs nobody out, but makes old address hashes useless.
APP_SECRET=

# How many reverse proxies sit in front of the server (they append to X-Forwarded-For). 0 = none: the header is ignored.
TRUST_PROXY=0

# debug | info | warn | error. Messages, addresses and passwords are never logged at any level.
LOG_LEVEL=info

# Rate limits on (true) or off (false, tests only).
RATE_LIMITS=true

# Largest request body, in bytes (1024 to 1048576).
BODY_LIMIT_BYTES=65536

# The contact and quote forms require the visitor's acknowledgement of how the data is used (the box on the form).
REQUIRE_CONSENT=true

# ---------------------------------------------------------------------------------------------------------------
# BACKEND — quotations (docs/quotes/README.md). A quote request gets a public reference, a quotation is e-mailed with
# a secure link, and the customer can accept or decline it on a private page. Sending a quotation needs e-mail AND
# PUBLIC_URL (the link points at the public site).
# How a request's public reference is written: letters, digits and hyphens around one sequence placeholder such as
# {NNNNNN} (the number, padded to that many digits), optionally with {YYYY} or {YY}, which also restarts the sequence each
# year. Requests made before the format was changed keep the reference they had. It is a name, never a secret.
QUOTE_REFERENCE_FORMAT=CC-{YYYY}-{NNNNNN}
# How long the link in a customer's e-mail (the quotation, the status page) works, in days (1 to 365). The buttons on the
# quotation page work for a couple of hours after the page is opened, once each.
CUSTOMER_LINK_DAYS=90

# ---------------------------------------------------------------------------------------------------------------
# BACKEND — e-mail (docs/email/README.md). OUTGOING mail goes through a transactional provider; INCOMING mail to the
# public address (hello@your-domain) is forwarded by Cloudflare Email Routing, which is not an outgoing mail server.
# Notifications to the owner; confirmations to the visitor only when an administrator turns them on in the
# administration; status e-mails to a customer only when an administrator asks. No value below is a real credential.
# ---------------------------------------------------------------------------------------------------------------

# none   = send nothing (requests are still stored and shown in the administration)
# resend = the transactional provider the project uses, over its HTTPS API (needs EMAIL_FROM and EMAIL_API_KEY)
# smtp   = send through an SMTP server of the owner's choice
# file   = write each message to EMAIL_FILE_DIR as an .eml file (development only; refused in production)
EMAIL_PROVIDER=none

# false = configured but PAUSED: nothing is queued or sent, and the administration says so. The way to prepare the provider and
# the DNS first and go live afterwards.
EMAIL_ENABLED=true

# resend: the API key (a secret: only here, never in the website, never in a log). Create it in the provider's dashboard as
# a key that can only SEND, limited to the verified domain. Example shape only: re_xxxxxxxxxxxxxxxxxxxxxxxx
EMAIL_API_KEY=
# The provider's API origin. Leave empty: https://api.resend.com. (Only a local test server may use http, and never in production.)
EMAIL_API_URL=
# resend: the secret that signs the provider's webhook calls to POST /api/webhooks/email (shown once the webhook is created in
# the provider's dashboard; it starts with whsec_). Without it the address does not exist and no message can ever be shown as delivered.
EMAIL_WEBHOOK_SECRET=

# The sender shown on every message: an address ON A DOMAIN YOU VERIFIED WITH THE PROVIDER, for example
# "Your Name <notifications@your-domain>". Never a visitor's address. And the one address that receives the notification of a
# new message or quote request (NOTIFY_TO, your private inbox: it is never shown to a visitor). Both are the OWNER's to decide;
# nothing is assumed. Without NOTIFY_TO nobody is notified.
EMAIL_FROM=
NOTIFY_TO=
# The PUBLIC contact address (for example hello@your-domain, the one Cloudflare Email Routing forwards): what a visitor's reply to
# a confirmation or a status e-mail goes to. Empty: replies go to the sender address.
EMAIL_REPLY_TO=
# Language of the owner's notifications: hu | en | nl.
NOTIFY_LANGUAGE=hu
# The name in the header of every e-mail.
BRAND_NAME=

# smtp: host, port (defaults 587 for starttls, 465 for tls, 25 for none), starttls | tls | none, credentials.
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=starttls
SMTP_USER=
SMTP_PASSWORD=
SMTP_TLS_REJECT_UNAUTHORIZED=true
SMTP_TIMEOUT_MS=15000

# file: where the .eml files go.
EMAIL_FILE_DIR=./data/mail

# How many times a message is tried before it is marked failed (1 to 20), with growing pauses between tries.
EMAIL_MAX_ATTEMPTS=5

# OPTIONAL, read-only: lets the administration's "set-up checks" see whether Cloudflare Email Routing is ready, whether a rule forwards
# the public address, and whether the destination mailbox was confirmed. Create an API token in Cloudflare with READ-ONLY permissions
# for the zone's Zone Settings and Email Routing rules and the account's Email Routing addresses (the token screen lists their exact
# names); the server only reads, it never changes anything there.
# All three or none. Without them the administration says it cannot see these, and nothing is claimed.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ZONE_ID=
CLOUDFLARE_ACCOUNT_ID=

# ---------------------------------------------------------------------------------------------------------------
# BACKEND — administration, retention, publishing, serving the website
# ---------------------------------------------------------------------------------------------------------------

# A sign-in lasts at most this many hours, and ends after this many minutes without use.
ADMIN_SESSION_HOURS=12
ADMIN_IDLE_MINUTES=30

# Delete completed, cancelled, declined and archived requests (and old delivery records) after this many days. EMPTY = keep everything
# until an administrator deletes it. The period is the owner's decision; see "Privacy" in docs/backend/README.md.
RETENTION_DAYS=

# An https address to POST to when an administrator presses "Publish" (a host's deploy hook that rebuilds the website).
DEPLOY_HOOK_URL=

# The built website (`dist/`) to serve from this same process, so one server is a complete deployment. Empty = API only.
STATIC_DIR=

# ---------------------------------------------------------------------------------------------------------------
# BACKEND — CONTROL ROOM AI (docs/ai/README.md). The website's AI assistant, answered by Claude through the Vercel AI SDK.
# The key and the model live ONLY here: the browser never sees them and cannot choose them. With no key the assistant is simply
# not offered and the rest of the site is unaffected. The limits below are the STARTING values: an administrator can change
# most of them in the administration (AI), and a saved value wins.
# ---------------------------------------------------------------------------------------------------------------

# The operator's master switch (true/false) and the provider's API key (a secret: never commit it, never put it in a VITE_ name).
AI_ASSISTANT_ENABLED=true
ANTHROPIC_API_KEY=

# THE MODEL IS NOT CONFIGURABLE. CONTROL ROOM AI runs exclusively on Anthropic Claude Haiku 5.5 (`claude-haiku-5-5`), a constant in
# server/src/modules/ai/model.ts. There is no variable for it. A leftover `ANTHROPIC_MODEL` is ignored (the server still starts) and,
# unless it says exactly claude-haiku-5-5, keeps the assistant switched off until it is removed. Switching it on also needs a
# successful connection test (administration: AI > Model and connection, or `npm run server:cli -- ai check`) and an explicit
# switch by an administrator: a successful test never turns the assistant on by itself.

# Another address for the provider's API (a proxy, or a local stand-in for tests). It must end in /v1. Leave empty for Anthropic.
ANTHROPIC_BASE_URL=

# Signs the anonymous session tokens. Empty = derived from APP_SECRET. At least 32 characters if set in production.
AI_SESSION_SECRET=

# How the model thinks: AI_EFFORT low | medium | high (default low), AI_THINKING adaptive | disabled (default adaptive).
# Thinking counts as output tokens, so keep effort low unless answers need to be more careful.
AI_EFFORT=low
AI_THINKING=adaptive

# Prices in USD per million tokens, as the provider publishes them (and the date you read them). Costs are ESTIMATES from the
# token counts the provider reports times these prices; they are not a bill. Change them when the provider changes them.
AI_PRICE_INPUT_PER_MTOK=0.10
AI_PRICE_OUTPUT_PER_MTOK=0.50
AI_PRICES_AS_OF=2026-10-06

# Budgets (USD). A request that could take the day or the month over its budget is refused BEFORE it starts. Conservative defaults.
AI_DAILY_BUDGET=1
AI_MONTHLY_BUDGET=10

# Raise an administration alert when a budget (cost, tokens, requests) reaches this percentage, and again when it is used up (1-100).
AI_ALERT_PERCENT=80
AI_DAILY_TOKEN_BUDGET=2000000
AI_DAILY_REQUESTS=1000
AI_MAX_DAILY_CONVERSATIONS=100

# Per message and per visitor.
AI_MAX_INPUT_CHARS=1200
AI_MAX_HISTORY_MESSAGES=20
AI_MAX_CONVERSATION_MESSAGES=60
AI_MAX_OUTPUT_TOKENS=1500
AI_MAX_TOOL_CALLS=6
AI_MAX_REQUESTS_PER_SESSION=40
AI_MAX_REQUESTS_PER_IP=30
AI_CONVERSATION_MAX_HOURS=24
AI_TIMEOUT_MS=90000

# Days the WORDS of a conversation are kept on the server (a visitor can delete theirs at any time). Counts and token numbers,
# which contain nothing a visitor wrote, are kept longer.
AI_RETENTION_DAYS=7

# ---------------------------------------------------------------------------------------------------------------
# WEBSITE (build time, public)
# ---------------------------------------------------------------------------------------------------------------

# The backend: its origin (https://api.example.com), or / when the backend serves the website (STATIC_DIR).
# Empty = no backend: the forms say they cannot send and never claim success.
VITE_API_URL=

# Used by `npm run catalog:pull` when VITE_API_URL is / (the backend's own address, at build time).
CATALOG_API_URL=

# The site's own address (canonical links, sitemap).
VITE_SITE_URL=

# Development only: `npm run dev` forwards /api/* to the backend (http://127.0.0.1:8787), so the administration at /admin works on the
# dev server exactly as it does in production (one origin). If the backend listens elsewhere, set API_PROXY_TARGET in the shell that
# starts the dev server (it is read from the environment, not from this file):  API_PROXY_TARGET=http://127.0.0.1:9000 npm run dev

# Only for a form handler that is NOT the backend in server/ (these win over VITE_API_URL when set).
VITE_CONTACT_ENDPOINT=
VITE_QUOTE_ENDPOINT=
VITE_ANALYTICS_ENDPOINT=
