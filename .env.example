# Settings for the AI creation server (server/ai3d). Copy this file to .env.local (git ignores it) and fill in
# what you want. NOTHING here starts with VITE_, so none of it can reach the browser bundle. Never commit a key.
#
# `npm run dev` and `npm run preview` read .env.local; `npm run ai3d` (a standalone server) reads the process environment.

# ── The engine ───────────────────────────────────────────────────────────────
# meshy | mock. Default: meshy when MESHY_API_KEY is set, otherwise none.
# `mock` is a stand-in that makes a cube and says so; it is for trying the whole path without an account.
# AI3D_PROVIDER=
# A paid Meshy account's API key (https://www.meshy.ai/developers/keys). Meshy has no free or shared test key.
# MESHY_API_KEY=
# latest | meshy-7.1 | meshy-6 | meshy-6-lite   (meshy-7 is deprecated, meshy-5 and meshy-t1 are retired)
# AI3D_MESHY_MODEL=latest
# Triangles the mesh is reduced to, 100 to 300000. Fewer is lighter on a phone.
# AI3D_MESHY_POLYCOUNT=30000
# Texture size of the second (texturing) step: 2k | 4k | 8k (meshy-6-lite makes 2k only)
# AI3D_MESHY_TEXTURE=2k
# 0 leaves out the metallic / roughness / normal maps (a smaller file)
# AI3D_MESHY_PBR=1
# 0 stops asking the engine to screen prompts
# AI3D_MESHY_MODERATION=1
# 0 offers the geometry only and never the (dearer) texturing step
# AI3D_ALLOW_REFINE=1

# ── The prompt writer (optional) ─────────────────────────────────────────────
# anthropic: a Claude model rewrites each description into one precise English prompt. Needs ANTHROPIC_API_KEY.
# AI3D_LLM=
# ANTHROPIC_API_KEY=
# claude-opus-5-5 by default; claude-haiku-5-5 is the cheaper, faster choice for a task this small.
# AI3D_LLM_MODEL=
# Longest rewritten prompt, in characters (at most 800, the engine's own limit)
# AI3D_MAX_PREPARED=600

# ── Limits and cost ──────────────────────────────────────────────────────────
# Longest description a visitor may send, in characters
# AI3D_MAX_PROMPT=240
# New models per visitor address per hour / texturing steps per visitor per hour / new models per day in total
# AI3D_MAX_JOBS_PER_HOUR=6
# AI3D_MAX_REFINES_PER_HOUR=3
# AI3D_MAX_JOBS_PER_DAY=60
# Tasks running at once, in total
# AI3D_MAX_CONCURRENT=3
# The most credits to spend in 24 hours (the engine's estimated prices; unset = no cap)
# AI3D_DAILY_CREDIT_BUDGET=
# A task is given up after this many seconds (the engine asks for an hour's patience)
# AI3D_TIMEOUT_SECONDS=3600
# The biggest model file kept and passed on, in bytes
# AI3D_MAX_MODEL_BYTES=52428800

# ── Storage and exposure ─────────────────────────────────────────────────────
# Keep jobs, models and a usage log on disk here (default: memory only, gone on restart).
# The engine deletes its own files after about three days, so a model is copied as soon as it is ready.
# AI3D_STORAGE_DIR=
# How long jobs and stored models are kept, in hours
# AI3D_KEEP_HOURS=72
# Comma-separated origins allowed to call the server from another site (default: this site only)
# AI3D_ALLOWED_ORIGINS=
# 1 to take the visitor's address from X-Forwarded-For; only behind a proxy you control
# AI3D_TRUST_PROXY=
