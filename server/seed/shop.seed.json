    "faq": [
      {
        "id": "price",
        "question": {
          "hu": "Ez egy fix árú csomag?",
          "en": "Is this a fixed-price package?",
          "nl": "Is dit een pakket met een vaste prijs?"
        },
        "answer": {
          "hu": "Nem. A FULL EXPERIENCE egyedi szolgáltatás: az ajánlatot a követelményeid ismeretében készítjük el, ezért itt nincs feltüntetett ár.",
          "en": "No. FULL EXPERIENCE is a custom service: the quote is written once your requirements are known, which is why no price is shown here.",
          "nl": "Nee. FULL EXPERIENCE is een dienst op maat: de offerte wordt opgesteld als jouw wensen bekend zijn, daarom staat hier geen prijs."
        }
      },
      {
        "id": "stages",
        "question": {
          "hu": "Kell minden szakaszra szükségem legyen?",
          "en": "Do I need every stage?",
          "nl": "Heb ik alle fasen nodig?"
        },
        "answer": {
          "hu": "Nem. A szakaszok és az összetevők a projekthez igazodnak: nem minden projekthez kell mindegyik, és amit nem kérsz, az nem része az ajánlatnak.",
          "en": "No. The stages and components follow the project: not every project needs all of them, and what you do not ask for is not part of the quote.",
          "nl": "Nee. De fasen en onderdelen volgen het project: niet elk project heeft ze allemaal nodig en wat je niet vraagt, maakt geen deel uit van de offerte."
        }
      },
      {
        "id": "idea",
        "question": {
          "hu": "Mi van, ha csak egy ötletem van?",
          "en": "What if I only have an idea?",
          "nl": "Wat als ik alleen een idee heb?"
        },
        "answer": {
          "hu": "Az is elég a kezdéshez. Az első lépés a feltárás: közösen tisztázzuk, mit szeretnél, és mi férhet bele.",
          "en": "That is enough to begin. The first step is discovery: together we settle what you want and what fits.",
          "nl": "Dat is genoeg om te beginnen. De eerste stap is de verkenning: samen bepalen we wat je wilt en wat past."
        }
      },
      {
        "id": "request",
        "question": {
          "hu": "Mi történik az ajánlatkérés után?",
          "en": "What happens after I send the request?",
          "nl": "Wat gebeurt er nadat ik de aanvraag heb verstuurd?"
        },
        "answer": {
          "hu": "Megkapjuk a válaszaidat, áttekintjük őket, és a megadott e-mail-címen jelentkezünk. Az ajánlatkérés semmire nem kötelez.",
          "en": "We receive your answers, read through them and get back to you at the e-mail address you give. Sending the request commits you to nothing.",
          "nl": "We ontvangen je antwoorden, lezen ze door en nemen contact met je op via het e-mailadres dat je opgeeft. Het versturen van de aanvraag verplicht tot niets."
        }
      }
