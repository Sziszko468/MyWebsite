{
  "name": "controlled-chaos-portfolio",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && npm run build:seo",
    "build:seo": "vite build --ssr src/seo/entry.ts --outDir node_modules/.cache/seo --emptyOutDir && node scripts/prerender.mjs",
    "check:seo": "node scripts/check-seo.mjs",
    "catalog:seed-export": "node scripts/export-catalog-seed.mjs",
    "catalog:pull": "node scripts/pull-catalog.mjs",
    "server:start": "node --disable-warning=ExperimentalWarning server/src/main.ts",
    "server:dev": "node --disable-warning=ExperimentalWarning --watch server/src/main.ts",
    "server:migrate": "node --disable-warning=ExperimentalWarning server/src/cli.ts migrate",
    "server:seed": "node --disable-warning=ExperimentalWarning server/src/cli.ts seed",
    "server:admin": "node --disable-warning=ExperimentalWarning server/src/cli.ts admin",
    "server:backup": "node --disable-warning=ExperimentalWarning server/src/cli.ts backup",
    "server:maintenance": "node --disable-warning=ExperimentalWarning server/src/cli.ts maintenance",
    "server:cli": "node --disable-warning=ExperimentalWarning server/src/cli.ts",
    "typecheck": "tsc -b",
    "lint": "oxlint",
    "test": "vitest run",
    "preview": "vite preview"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.99",
    "@ai-sdk/react": "^4.0.168",
    "@fontsource-variable/archivo": "^5.3.0",
    "@react-three/fiber": "^9.8.2",
    "ai": "^7.0.166",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.0",
    "three": "^0.186.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^6.1.2",
    "oxlint": "^1.88.0",
    "sass": "^1.106.1",
    "typescript": "~6.0.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}
